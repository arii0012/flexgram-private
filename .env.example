APP_NAME=FlexGram
APP_ENV=development
PORT=8080

POSTGRES_USER=nova_user
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=nova_messenger

